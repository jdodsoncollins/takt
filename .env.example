# Copy to `.env` and fill in values for your own build.
# Expo loads this file automatically. Variables prefixed EXPO_PUBLIC_ are
# inlined into the JS bundle at build time.

# Display name and URL scheme
EXPO_PUBLIC_APP_NAME=Taktung
EXPO_PUBLIC_SLUG=takt
EXPO_PUBLIC_SCHEME=takt

# Native identifiers. Use your own reverse-DNS IDs for store builds.
EXPO_PUBLIC_BUNDLE_ID=com.example.takt
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.takt

# Apple Developer team ID (optional for simulator; required for device/store)
EXPO_PUBLIC_APPLE_TEAM_ID=

# EAS (optional; run `eas init` if you use EAS Build)
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_OWNER=

# App Store Connect app ID for `eas submit` / TestFlight (optional)
EXPO_PUBLIC_ASC_APP_ID=

# Vercel OAuth. Create an app at vercel.com and set redirect to
# `${EXPO_PUBLIC_SCHEME}://oauth/callback`. Leave empty to use PAT-only auth.
EXPO_PUBLIC_VERCEL_CLIENT_ID=
EXPO_PUBLIC_OAUTH_REDIRECT_URI=
EXPO_PUBLIC_VERCEL_OAUTH_SCOPE=offline_access

# Shown in Settings when set. Leave empty to hide the Privacy Policy link.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Optional "other apps" row in Settings (iOS). Leave empty to hide.
EXPO_PUBLIC_OTHER_APP_STORE_URL=
EXPO_PUBLIC_OTHER_APP_NAME=
EXPO_PUBLIC_OTHER_APP_BLURB=

# Optional support URL for store listings
EXPO_PUBLIC_SUPPORT_URL=

# Screenshot / Maestro app id (defaults to EXPO_PUBLIC_BUNDLE_ID)
# EXPO_PUBLIC_BUNDLE_ID=com.example.takt
